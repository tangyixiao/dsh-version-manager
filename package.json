{
  "name": "dsh-version-manager",
  "version": "0.1.0",
  "description": "Version management for DSH plugins and skills: an honest inventory of what is installed, a preview of what an update would change, a verifiable snapshot taken before the change, and a recovery path that is only offered when it can actually work.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs/baseline.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "version",
    "update",
    "snapshot",
    "skill"
  ],
  "author": "Tang Yixiao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangyixiao/dsh-version-manager.git"
  },
  "homepage": "https://github.com/tangyixiao/dsh-version-manager#readme",
  "bugs": {
    "url": "https://github.com/tangyixiao/dsh-version-manager/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "prepublishOnly": "npm test"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
